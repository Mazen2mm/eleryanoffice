# =====================================================================
# انسخ الملف ده باسم .env.local (في نفس المجلد) واملأ القيم.
# .env.local منه في .gitignore بالفعل ومبيترفعش لأي مكان عام.
# =====================================================================

# --- بيانات الحساب الرئيسي (بدل الكود القديم اللي كان ظاهر في المتصفح) ---
MASTER_ADMIN_USERNAME=eleryanofficeteam
# لازم تحط هنا الـ hash مش كلمة المرور نفسها. اعمل الآتي عشان تولّده:
# 1) شغّل: node -e "console.log(require('crypto').createHash('sha256').update('كلمة_المرور_الجديدة_هنا').digest('hex'))"
# 2) انسخ الناتج وحطه هنا
MASTER_ADMIN_PASSWORD_HASH=

# --- سر توقيع جلسة تسجيل الدخول (نص عشوائي طويل، متشاركوش مع حد) ---
# ولّده بالأمر: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- بيانات حساب خدمة Firebase (Service Account) ---
# من Firebase Console: Project Settings > Service Accounts > Generate new private key
# هيديك ملف JSON، خد منه القيم دي:
FIREBASE_PROJECT_ID=eleryanoffice0
FIREBASE_CLIENT_EMAIL=
# القيمة دي طويلة ومتعددة الأسطر، لازم تتلف بين علامتي تنصيص وتفضل \n زي ما هي:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
