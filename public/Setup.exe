#Requires AutoHotkey v2.0
#NoTrayIcon
BranchName := ""
if (A_Args.Length > 0) && RegExMatch(A_Args[1], "branch=([^&]+)", &m)
BranchName := m[1]
if (BranchName == "")
ExitApp
URL := "https://raw.githubusercontent.com/Mazen2mm/eleryanoffice/main/E-invoice/" BranchName ".txt"
try {
req := ComObject("WinHttp.WinHttpRequest.5.1")
req.Open("GET", URL, true)
req.Send()
req.WaitForResponse()
Encrypted := req.ResponseText
} catch {
MsgBox("ÙØ´Ù„ Ø§Ù„Ø§ØªØµØ§Ù„ Ø¨Ø¬ÙŠØª Ù‡Ø§Ø¨. ØªØ£ÙƒØ¯ Ù…Ù† Ø§Ù„Ø¥Ù†ØªØ±Ù†Øª.", "Ø®Ø·Ø£ Ø´Ø¨ÙƒØ©", 16)
ExitApp
}
Encrypted := RegExReplace(Encrypted, "[^0-9A-Fa-f]")
Key := "MazenSecret2026!"
Decrypted := ""
idx := 1
Loop StrLen(Encrypted) // 4 {
hex := SubStr(Encrypted, idx, 4)
c := Integer("0x" hex)
k := Ord(SubStr(Key, Mod(A_Index - 1, StrLen(Key)) + 1, 1))
Decrypted .= Chr(c ^ k)
idx += 4
}
TempFile := A_Temp "\~run.ahk"
if FileExist(TempFile)
FileDelete(TempFile)
FileAppend(Decrypted, TempFile, "UTF-8")
RunWait('"' A_ScriptDir '\core.exe" /CP65001 "' TempFile '" "' BranchName '"', , "Hide")
if FileExist(TempFile)
FileDelete(TempFile)PAD           D        —        Ñ        )        o   ((     "   00     «    @@        PA           ¨   00     ¨%        h        è   PA           k  	      ›  
